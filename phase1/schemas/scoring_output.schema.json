{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scale-SETI Scoring Output v0.3",
  "type": "object",
  "required": [
    "trial_id",
    "condition_code",
    "hamming_distance",
    "bit_accuracy",
    "exact_match"
  ],
  "properties": {
    "trial_id": {
      "type": "string"
    },
    "condition_code": {
      "type": "string"
    },
    "hamming_distance": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "bit_accuracy": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "exact_match": {
      "type": "boolean"
    },
    "receiver_correlation": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "telemetry_flag": {
      "type": "boolean"
    }
  }
}